generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}
enum TenantStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}
enum TenantRole {
  OWNER
  ADMIN
  MEMBER
  BILLING
  VIEWER
}
enum LinkStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}
enum DomainStatus {
  PENDING_VERIFICATION
  VERIFIED
  ROUTING_PENDING
  ACTIVE
  SUSPENDED
  FAILED
}
enum TlsStatus {
  NOT_CONFIGURED
  PENDING
  ACTIVE
  FAILED
}
enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}
enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELED
}
enum PlanInterval {
  MONTH
  YEAR
}
enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}
enum WebhookProcessingStatus {
  RECEIVED
  VERIFIED
  PROCESSING
  PROCESSED
  FAILED
}

model User {
  id String @id @default(cuid())
  email String @unique
  emailVerifiedAt DateTime?
  passwordHash String
  displayName String?
  status UserStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  memberships TenantMember[]
  auditLogs AuditLog[] @relation("AuditActor")
  profile UserProfile?
  authTokens AuthToken[]
}
model Session {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@index([userId, expiresAt])
}
model Tenant {
  id String @id @default(cuid())
  name String
  slug String @unique
  status TenantStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members TenantMember[]
  invitations WorkspaceInvitation[]
  links Link[]
  domains Domain[]
  campaigns Campaign[]
  subscriptions Subscription[]
  invoices Invoice[]
  payments PaymentAttempt[]
  clickEvents ClickEvent[]
  posts Post[]
  categories Category[]
  mediaAssets MediaAsset[]
  apiKeys ApiKey[]
  auditLogs AuditLog[]
  @@unique([id])
}
model TenantMember {
  id String @id @default(cuid())
  tenantId String
  userId String
  role TenantRole @default(MEMBER)
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade)
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@unique([tenantId,userId])
  @@index([userId])
}
model Campaign {
  id String @id @default(cuid())
  tenantId String
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade)
  links Link[]
  @@unique([tenantId,id])
  @@unique([tenantId,name])
  @@index([tenantId,createdAt])
}
model Link {
  id String @id @default(cuid())
  tenantId String
  campaignId String?
  slug String @unique
  targetUrl String
  title String?
  status LinkStatus @default(ACTIVE)
  redirectCode Int @default(302)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade)
  campaign Campaign? @relation(fields:[tenantId,campaignId], references:[tenantId,id], onDelete:Restrict)
  domainSlugs LinkDomainSlug[]
  clickEvents ClickEvent[]
  @@unique([tenantId,id])
  @@index([tenantId,createdAt])
  @@index([tenantId,status])
}
model Domain {
  id String @id @default(cuid())
  tenantId String
  hostname String @unique
  verificationTokenHash String? @unique
  verificationExpiresAt DateTime?
  verificationAttempts Int @default(0)
  status DomainStatus @default(PENDING_VERIFICATION)
  tlsStatus TlsStatus @default(NOT_CONFIGURED)
  verifiedAt DateTime?
  routingEnabledAt DateTime?
  originUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade)
  slugMappings LinkDomainSlug[]
  @@unique([tenantId,id])
  @@index([tenantId,status])
}
model LinkDomainSlug {
  id String @id @default(cuid())
  tenantId String
  domainId String
  linkId String
  slug String
  createdAt DateTime @default(now())
  domain Domain @relation(fields:[tenantId,domainId], references:[tenantId,id], onDelete:Cascade)
  link Link @relation(fields:[tenantId,linkId], references:[tenantId,id], onDelete:Cascade)
  @@unique([domainId,slug])
  @@unique([domainId,linkId])
  @@index([tenantId,linkId])
}
model ClickEvent {
  id String @id @default(cuid())
  tenantId String
  linkId String
  occurredAt DateTime @default(now())
  refererHost String?
  countryCode String? @db.VarChar(2)
  deviceType String?
  browser String?
  os String?
  ipHash String?
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade)
  link Link @relation(fields:[tenantId,linkId], references:[tenantId,id], onDelete:Cascade)
  @@index([tenantId,occurredAt])
  @@index([tenantId,linkId,occurredAt])
}
model Plan {
  id String @id @default(cuid())
  code String @unique
  name String
  priceMinor Int
  currency String @default("VND") @db.VarChar(3)
  interval PlanInterval @default(MONTH)
  entitlements Json
  active Boolean @default(true)
  createdAt DateTime @default(now())
  subscriptions Subscription[]
}
model Subscription {
  id String @id @default(cuid())
  tenantId String
  planId String
  status SubscriptionStatus @default(INCOMPLETE)
  provider String?
  providerSubscriptionId String?
  trialEndsAt DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd DateTime?
  cancelAtPeriodEnd Boolean @default(false)
  canceledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade)
  plan Plan @relation(fields:[planId], references:[id])
  invoices Invoice[]
  @@unique([provider,providerSubscriptionId])
  @@index([tenantId,status])
}
model Invoice {
  id String @id @default(cuid())
  tenantId String
  subscriptionId String?
  number String @unique
  status InvoiceStatus @default(DRAFT)
  amountMinor Int
  currency String @default("VND") @db.VarChar(3)
  planSnapshot Json
  lineItems Json
  dueAt DateTime?
  paidAt DateTime?
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade)
  subscription Subscription? @relation(fields:[subscriptionId], references:[id], onDelete:SetNull)
  payments PaymentAttempt[]
  @@index([tenantId,createdAt])
}
model PaymentAttempt {
  id String @id @default(cuid())
  tenantId String
  invoiceId String
  provider String
  providerPaymentId String?
  idempotencyKey String @unique
  status PaymentStatus @default(PENDING)
  amountMinor Int
  currency String @default("VND") @db.VarChar(3)
  paidAt DateTime?
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade)
  invoice Invoice @relation(fields:[invoiceId], references:[id], onDelete:Cascade)
  webhookEvents WebhookEvent[]
  @@unique([provider,providerPaymentId])
  @@index([tenantId,status])
}
model WebhookEvent {
  id String @id @default(cuid())
  provider String
  providerEventId String
  paymentAttemptId String?
  payload Json
  signatureVerifiedAt DateTime?
  status WebhookProcessingStatus @default(RECEIVED)
  receivedAt DateTime @default(now())
  processedAt DateTime?
  failureReason String?
  paymentAttempt PaymentAttempt? @relation(fields:[paymentAttemptId], references:[id], onDelete:SetNull)
  @@unique([provider,providerEventId])
  @@index([status,receivedAt])
}
model ApiKey {
  id String @id @default(cuid())
  tenantId String
  name String
  keyPrefix String
  keyHash String @unique
  lastUsedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade)
  @@index([tenantId,revokedAt])
}
model AuditLog {
  id String @id @default(cuid())
  tenantId String?
  actorId String?
  action String
  entityType String
  entityId String?
  metadata Json?
  createdAt DateTime @default(now())
  tenant Tenant? @relation(fields:[tenantId], references:[id], onDelete:SetNull)
  actor User? @relation("AuditActor", fields:[actorId], references:[id], onDelete:SetNull)
  @@index([tenantId,createdAt])
  @@index([actorId,createdAt])
}
model Category {
  id String @id @default(cuid())
  tenantId String
  name String
  slug String
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade)
  posts Post[]
  @@unique([tenantId,id])
  @@unique([tenantId,slug])
}
model Post {
  id String @id @default(cuid())
  tenantId String
  categoryId String?
  title String
  slug String
  excerpt String?
  content String
  status PostStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade)
  category Category? @relation(fields:[tenantId,categoryId], references:[tenantId,id], onDelete:SetNull)
  seo SeoMetadata?
  media MediaAsset[]
  @@unique([tenantId,id])
  @@unique([tenantId,slug])
  @@index([tenantId,status,publishedAt])
}
model SeoMetadata {
  id String @id @default(cuid())
  postId String @unique
  metaTitle String?
  metaDescription String?
  canonicalUrl String?
  robots String?
  schemaJson Json?
  ogImageUrl String?
  post Post @relation(fields:[postId], references:[id], onDelete:Cascade)
}
model MediaAsset {
  id String @id @default(cuid())
  tenantId String
  postId String?
  storageKey String @unique
  publicUrl String
  mimeType String
  sizeBytes BigInt
  altText String?
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade)
  post Post? @relation(fields:[tenantId,postId], references:[tenantId,id], onDelete:SetNull)
  @@index([tenantId,createdAt])
}

model UserProfile {
 id String @id @default(cuid())
 userId String @unique
 phone String?
 company String?
 jobTitle String?
 website String?
 location String?
 bio String?
 avatarUrl String?
 timezone String @default("Asia/Ho_Chi_Minh")
 locale String @default("vi-VN")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
}
model SitePage {
 id String @id @default(cuid())
 slug String @unique
 title String
 content Json
 status PostStatus @default(DRAFT)
 metaTitle String?
 metaDescription String?
 canonicalUrl String?
 ogTitle String?
 ogDescription String?
 ogImageUrl String?
 robots String @default("index,follow")
 schemaJson Json?
 publishedAt DateTime?
 updatedAt DateTime @updatedAt
 createdAt DateTime @default(now())
 @@index([status,publishedAt])
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}
model AuthToken {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  purpose AuthTokenPurpose
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@index([userId,purpose,expiresAt])
}


model WorkspaceInvitation {
  id String @id @default(cuid())
  tenantId String
  email String
  role TenantRole @default(MEMBER)
  tokenHash String @unique
  invitedById String
  expiresAt DateTime
  acceptedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade)
  @@index([tenantId,email,createdAt])
  @@index([expiresAt])
}
