NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3013
DATABASE_URL=postgresql://user:password@localhost:5432/funlink?schema=public

# VNPay merchant credentials (store real values only in deployment secrets)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# PayPal webhook configuration (use the registered webhook ID, not the client ID)
PAYPAL_WEBHOOK_ID=

# Binance Pay merchant public key/certificate details (PEM value stored as a secret)
BINANCE_PAY_CERTIFICATE_SN=
BINANCE_PAY_PUBLIC_KEY=

# Payment checkout return destinations
PAYMENT_RETURN_URL=https://example.com/billing/return
PAYMENT_CANCEL_URL=https://example.com/billing/cancel

# VNPay checkout (use the official sandbox URL for test credentials)
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# PayPal REST API (sandbox base for test credentials; live merchants must use the live API base)
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Binance Pay OpenAPI (store PEM private key only in deployment secrets)
BINANCE_PAY_API_BASE_URL=https://bpay.binanceapi.com
BINANCE_PAY_API_KEY=
BINANCE_PAY_API_SECRET=
BINANCE_PAY_WEBHOOK_URL=
