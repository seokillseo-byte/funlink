{
  "name": "funlink",
  "version": "0.2.0",
  "private": true,
  "description": "FunLink URL shortener MVP and SaaS foundation",
  "main": "server.js",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "db:format": "prisma format --schema prisma/schema.prisma",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "api:dev": "pnpm --filter @funlink/api dev",
    "api:build": "pnpm --filter @funlink/api build",
    "api:typecheck": "pnpm --filter @funlink/api typecheck",
    "api:test": "pnpm --filter @funlink/api test",
    "web:dev": "pnpm --filter @funlink/web dev",
    "web:build": "pnpm --filter @funlink/web build",
    "web:typecheck": "pnpm --filter @funlink/web typecheck"
  },
  "devDependencies": {
    "prisma": "6.19.0"
  },
  "dependencies": {
    "@prisma/client": "6.19.0"
  }
}